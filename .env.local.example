# Copy this file to .env.local and fill in the values

# Admin login password for /admin
ADMIN_PASSWORD=your_password_here

# 32-byte hex secret for the session cookie HMAC
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=your_32_byte_hex_secret_here

# Supabase — stores contact form submissions (table: greenwatt_contact_submissions)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
# service_role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend — email notifications for new contact submissions
RESEND_API_KEY=your_resend_api_key_here
# Optional: sender on a verified Resend domain. Defaults to the sandbox sender
# (onboarding@resend.dev), which only delivers to the Resend account owner.
# RESEND_FROM=Greenwatt Contact <noreply@your-verified-domain.com>
